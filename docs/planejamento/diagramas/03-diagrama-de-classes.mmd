classDiagram
  direction LR
  class Usuario {
    +int id
    +str nome
    +str email
    +str senha_hash
    +str telefone
    +Perfil perfil
    +datetime criado_em
    +definir_senha(senha)
    +verificar_senha(senha) bool
    +eh_admin() bool
  }
  class Categoria {
    +int id
    +str nome
    +str descricao
  }
  class Produto {
    +int id
    +str nome
    +str descricao
    +str ingredientes
    +str alergenicos
    +decimal preco
    +int estoque
    +str imagem
    +bool ativo
    +datetime criado_em
    +disponivel() bool
    +baixar_estoque(qtd)
    +repor_estoque(qtd)
  }
  class Pedido {
    +int id
    +StatusPedido status
    +Modalidade modalidade
    +str cep
    +str logradouro
    +str numero
    +str complemento
    +str bairro
    +decimal subtotal
    +decimal taxa_entrega
    +decimal total
    +datetime criado_em
    +calcular_totais()
    +proximo_status() StatusPedido
    +avancar_status()
    +pode_cancelar() bool
    +cancelar()
  }
  class ItemPedido {
    +int id
    +int quantidade
    +decimal preco_unitario
    +subtotal() decimal
  }
  class Pagamento {
    +int id
    +MetodoPagamento metodo
    +StatusPagamento status
    +decimal valor
    +str cartao_final
    +str codigo_transacao
    +datetime criado_em
  }
  class HistoricoStatus {
    +int id
    +StatusPedido status
    +str observacao
    +datetime criado_em
  }
  class Perfil {
    <<enumeration>>
    CLIENTE
    ADMIN
  }
  class StatusPedido {
    <<enumeration>>
    AGUARDANDO_PAGAMENTO
    PAGO
    EM_PREPARO
    SAIU_PARA_ENTREGA
    PRONTO_PARA_RETIRADA
    ENTREGUE
    CANCELADO
  }
  class Modalidade {
    <<enumeration>>
    ENTREGA
    RETIRADA
  }
  class MetodoPagamento {
    <<enumeration>>
    CREDITO
    DEBITO
    PIX
  }
  class StatusPagamento {
    <<enumeration>>
    APROVADO
    RECUSADO
    ESTORNADO
  }
  Usuario "1" --> "0..*" Pedido : faz
  Categoria "1" o-- "0..*" Produto : agrupa
  Pedido "1" *-- "1..*" ItemPedido : contém
  ItemPedido "0..*" --> "1" Produto : refere-se a
  Pedido "1" *-- "0..*" Pagamento : tentativas
  Pedido "1" *-- "1..*" HistoricoStatus : registra
  Usuario ..> Perfil
  Pedido ..> StatusPedido
  Pedido ..> Modalidade
  Pagamento ..> MetodoPagamento
  Pagamento ..> StatusPagamento
